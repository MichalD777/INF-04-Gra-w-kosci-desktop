<Window x:Class="Gra_w_kości_2026_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gra_w_kości_2026_desktop"
        mc:Ignorable="d"
        Title="Kosci" Height="700" Width="600" Background="#ED27C121">
    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Image MouseLeftButtonUp="kosc_MouseLeftButtonUp" Name="kosc1" Source="{Binding Kosci[0]}" Width="120"  Margin="10" Tag="0"/>
            <Image MouseLeftButtonUp="kosc_MouseLeftButtonUp" Grid.Column="1" Name="kosc2" Source="{Binding Kosci[1]}"  Margin="10" Width="120" Tag="1"/>
        </Grid>

        <Grid HorizontalAlignment="Center" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Image MouseLeftButtonUp="kosc_MouseLeftButtonUp" Name="kosc3" Source="{Binding Kosci[2]}" Width="120" Margin="10" Tag="2"/>
            <Image MouseLeftButtonUp="kosc_MouseLeftButtonUp" Grid.Column="1" Name="kosc4" Source="{Binding Kosci[3]}"  Margin="10" Width="120" Tag="3"/>
            <Image MouseLeftButtonUp="kosc_MouseLeftButtonUp" Grid.Column="2" Name="kosc5" Source="{Binding Kosci[4]}"  Margin="10" Width="120" Tag="4"/>
        </Grid>

        <Grid HorizontalAlignment="Center" Grid.Row="2" Margin="10">
            <Button Background="#ED275021" Height="50" Width="80" Content="RZUT" Command="{Binding ThrowCommand}" Foreground="white" FontSize="20"/>
        </Grid>

        <Grid HorizontalAlignment="Center" Grid.Row="3" Margin="10">
            <Label Content="{Binding Suma}" Foreground="white" FontSize="40" />
        </Grid>
    </Grid>
</Window>
